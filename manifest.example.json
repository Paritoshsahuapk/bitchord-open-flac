{
  "id": "in.paritosh.bitchord.archive-flac",
  "name": "Open FLAC Search",
  "version": "1.0.0",
  "description": "Searches Internet Archive for playable FLAC recordings. Commercial catalogue coverage is limited.",
  "resources": [
    "search",
    "stream"
  ],
  "allowDownloads": 1,
  "settings": [
    {
      "key": "quality",
      "type": "select",
      "default": "lossless",
      "options": [
        {
          "label": "Lossless",
          "value": "lossless"
        },
        {
          "label": "High",
          "value": "high"
        },
        {
          "label": "Low",
          "value": "low"
        }
      ]
    }
  ]
}